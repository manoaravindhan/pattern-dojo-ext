{
  "name": "pattern-lens",
  "displayName": "Pattern Lens",
  "description": "Detects design pattern issues and highlights them with a scalable architecture",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "publisher": "vivarium-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manoaravindhan/pattern-dojo-ext.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:java",
    "onLanguage:python",
    "onLanguage:csharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pattern-lens-activity",
          "title": "Pattern Lens",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "pattern-lens-activity": [
        {
          "id": "pattern-lens.welcome",
          "name": "Welcome",
          "icon": "images/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pattern-lens.refresh",
        "title": "Refresh Pattern Analysis"
      },
      {
        "command": "pattern-lens.reportIssue",
        "title": "Report Pattern Issue"
      }
    ],
    "configuration": {
      "title": "Pattern Lens",
      "properties": {
        "pattern-lens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Pattern Lens analysis"
        },
        "pattern-lens.patterns": {
          "type": "object",
          "default": {
            "singleton": true,
            "factory": true,
            "observer": true,
            "strategy": true,
            "decorator": true,
            "adapter": true,
            "facade": true,
            "proxy": true
          },
          "description": "Enable or disable specific design patterns"
        },
        "pattern-lens.severity": {
          "type": "object",
          "default": {
            "singleton": "warning",
            "factory": "information",
            "observer": "warning",
            "strategy": "information",
            "decorator": "information",
            "adapter": "information",
            "facade": "information",
            "proxy": "information"
          },
          "description": "Severity level for pattern violations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^11.7.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.26.3"
  }
}
